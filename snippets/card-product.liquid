{% comment %}
  VastrVeda Editorial Product Card Snippet (Double-Bezel Architecture)
  Usage: {% render 'card-product', product: product %}
{% endcomment %}

<div class="product-card-shell">
  <div class="product-media-container">
    {% if product.tags contains 'Bespoke' or product.tags contains 'Wedding' or product.tags contains 'Festive' %}
      <span class="product-badge-pill">
        {% if product.tags contains 'Wedding' %}Wedding Couture{% elsif product.tags contains 'Festive' %}Festive Edition{% else %}Jaipur Atelier{% endif %}
      </span>
    {% endif %}

    <button type="button" class="product-wishlist-btn" aria-label="Save to Wishlist">
      {% render 'icons', name: 'heart' %}
    </button>

    <a href="{{ product.url }}" class="product-img-link">
      {% if product.featured_image %}
        <img 
          src="{{ product.featured_image | image_url: width: 700 }}" 
          alt="{{ product.title | escape }}"
          class="product-main-image"
          loading="lazy"
          width="700"
          height="950"
        >
        {% if product.images[1] %}
          <img 
            src="{{ product.images[1] | image_url: width: 700 }}" 
            alt="{{ product.title | escape }}"
            class="product-hover-image"
            loading="lazy"
            width="700"
            height="950"
          >
        {% endif %}
      {% else %}
        <div style="background: #F2EDE4; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #9A8E7F; min-height: 360px;">
          {% render 'icons', name: 'lotus' %}
        </div>
      {% endif %}
    </a>

    <div class="product-quick-actions">
      {% if product.available %}
        <form method="post" action="/cart/add" class="quick-add-form" style="width: 100%;">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit" class="quick-add-btn">
            <span>Quick Add to Bag</span>
          </button>
        </form>
      {% else %}
        <button type="button" class="quick-add-btn" style="background: #888; color: #fff;" disabled>
          <span>Sold Out</span>
        </button>
      {% endif %}
    </div>
  </div>

  <div class="product-info-box">
    <span class="product-artisan-tag">HANDCRAFTED IN JAIPUR</span>
    <h3 class="product-title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-price-row">
      <span class="price-current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>
  </div>
</div>
