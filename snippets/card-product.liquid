{% comment %}
  VastrVeda Royal Product Card Snippet
  Usage: {% render 'card-product', product: product %}
{% endcomment %}

<div class="product-card">
  <div class="product-media-container">
    {% if product.tags contains 'Bespoke' or product.tags contains 'Wedding' or product.tags contains 'Festive' %}
      <span class="product-badge-pill">
        {% if product.tags contains 'Wedding' %}Wedding Couture{% elsif product.tags contains 'Festive' %}Festive Special{% else %}Jaipur Handcrafted{% endif %}
      </span>
    {% endif %}

    <button type="button" class="product-wishlist-btn" aria-label="Save to Wishlist">
      {% render 'icons', name: 'heart' %}
    </button>

    <a href="{{ product.url }}" class="product-img-link">
      {% if product.featured_image %}
        <img 
          src="{{ product.featured_image | image_url: width: 600 }}" 
          alt="{{ product.title | escape }}"
          class="product-main-image"
          loading="lazy"
          width="600"
          height="800"
        >
        {% if product.images[1] %}
          <img 
            src="{{ product.images[1] | image_url: width: 600 }}" 
            alt="{{ product.title | escape }}"
            class="product-hover-image"
            loading="lazy"
            width="600"
            height="800"
          >
        {% endif %}
      {% else %}
        <div style="background: #EFE9DE; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #8C7B7D;">
          {% render 'icons', name: 'lotus' %}
        </div>
      {% endif %}
    </a>

    <div class="product-quick-actions">
      {% if product.available %}
        <form method="post" action="/cart/add" class="quick-add-form" style="flex: 1;">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <button type="submit" class="quick-add-btn">
            {% render 'icons', name: 'cart' %}
            <span>Add to Bag</span>
          </button>
        </form>
      {% else %}
        <button type="button" class="quick-add-btn" style="background: #666; color: #fff;" disabled>
          <span>Sold Out</span>
        </button>
      {% endif %}
    </div>
  </div>

  <div class="product-info-box">
    <span class="product-artisan-tag">Rooted in Jaipur</span>
    <h3 class="product-title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-price-row">
      <span class="price-current">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>
  </div>
</div>
