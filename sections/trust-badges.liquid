{% comment %}
  VastrVeda Royal Trust & Guarantees Section
{% endcomment %}

<section class="trust-badges-section">
  <div class="vv-container">
    <div class="trust-badges-grid">
      <div class="trust-badge-card">
        <div class="trust-badge-icon">
          {% render 'icons', name: 'needle' %}
        </div>
        <div>
          <h4 class="trust-badge-title">Handcrafted in Jaipur</h4>
          <p class="trust-badge-sub">Ancestral karigari & authentic Gota Patti</p>
        </div>
      </div>

      <div class="trust-badge-card">
        <div class="trust-badge-icon">
          {% render 'icons', name: 'truck' %}
        </div>
        <div>
          <h4 class="trust-badge-title">Royal Delivery</h4>
          <p class="trust-badge-sub">Free express shipping across all India</p>
        </div>
      </div>

      <div class="trust-badge-card">
        <div class="trust-badge-icon">
          {% render 'icons', name: 'shield' %}
        </div>
        <div>
          <h4 class="trust-badge-title">Pure Certified Silks</h4>
          <p class="trust-badge-sub">100% genuine zari, velvet & brocade</p>
        </div>
      </div>

      <div class="trust-badge-card">
        <div class="trust-badge-icon">
          {% render 'icons', name: 'whatsapp' %}
        </div>
        <div>
          <h4 class="trust-badge-title">Bridal Styling Help</h4>
          <p class="trust-badge-sub">Direct WhatsApp video consultation</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Trust Badges"
    }
  ]
}
{% endschema %}
