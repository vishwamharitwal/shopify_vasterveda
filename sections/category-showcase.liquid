{% comment %}
  VastrVeda Editorial Category Showcase (Vogue / Sabyasachi Standard)
{% endcomment %}

<section class="category-section">
  <div class="vv-container">
    <div class="editorial-header">
      <span class="editorial-tag">{{ section.settings.subheading | default: 'THE ROYAL WARDROBE' }}</span>
      <h2 class="editorial-title">{{ section.settings.title | default: 'Curated <em>Jaipur</em> Editions' }}</h2>
      <div class="editorial-divider"></div>
    </div>

    <div class="category-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: '/collections/all' }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="category-img-box">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 700 }}" 
                alt="{{ block.settings.title | escape }}" 
                class="category-img"
                loading="lazy"
                width="700"
                height="950"
              >
            {% else %}
              {% case forloop.index %}
                {% when 1 %}
                  <img src="https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=700&q=85" alt="Wedding Wears" class="category-img" loading="lazy" width="700" height="950">
                {% when 2 %}
                  <img src="https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=700&q=85" alt="Kurti Sets" class="category-img" loading="lazy" width="700" height="950">
                {% when 3 %}
                  <img src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=700&q=85" alt="Royal Lehengas" class="category-img" loading="lazy" width="700" height="950">
                {% else %}
                  <img src="https://images.unsplash.com/photo-1594913785162-e67866e4a282?auto=format&fit=crop&w=700&q=85" alt="Festive Wears" class="category-img" loading="lazy" width="700" height="950">
              {% endcase %}
            {% endif %}
          </div>
          <div class="category-caption">
            <h3 class="category-title">{{ block.settings.title }}</h3>
            <span class="category-subtitle">{{ block.settings.subtitle | default: 'DISCOVER' }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Showcase",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "THE ROYAL WARDROBE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Curated Jaipur Editions"
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Wedding Couture"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Tag",
          "default": "Bridal & Heritage Sets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Showcase",
      "blocks": [
        {
          "type": "category_item",
          "settings": {
            "title": "Wedding Wears",
            "subtitle": "Bridal Couture"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "title": "Kurti Sets",
            "subtitle": "Handcrafted Silhouettes"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "title": "Royal Lehengas",
            "subtitle": "Zari & Pure Velvet"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "title": "Festive Wears",
            "subtitle": "Shararas & Anarkalis"
          }
        }
      ]
    }
  ]
}
{% endschema %}
