{% comment %}
  VastrVeda Master Collection Grid Section
{% endcomment %}

<section class="collection-section" style="padding: 60px 0 90px;">
  <div class="vv-container">
    <div class="royal-heading-wrapper">
      <span class="royal-subheading">Jaipur Couture Edit</span>
      <h1 class="royal-title">{{ collection.title | default: 'All Royal Collections' }}</h1>
      <div class="royal-divider">
        <span class="royal-divider-line"></span>
        <span class="royal-divider-icon">{% render 'icons', name: 'lotus' %}</span>
        <span class="royal-divider-line"></span>
      </div>
      {% if collection.description != blank %}
        <p style="max-width: 650px; margin: 16px auto 0; font-size: 0.95rem; color: var(--vv-text-muted);">
          {{ collection.description }}
        </p>
      {% endif %}
    </div>

    <!-- Collection Grid -->
    <div class="product-grid">
      {% if collection.products_count > 0 %}
        {% for product in collection.products %}
          {% render 'card-product', product: product %}
        {% endfor %}
      {% else %}
        <!-- Mock Items Preview -->
        {% assign mock_titles = "Bespoke Crimson Bridal Lehenga,Gulabi Nagri Silk Kurti Set,Royal Velvet Anarkali Suit,Zardozi Embroidered Festive Lehenga" | split: "," %}
        {% assign mock_prices = "₹42,000,₹6,499,₹9,999,₹34,500" | split: "," %}
        {% assign mock_images = "https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=600&q=80,https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=600&q=80,https://images.unsplash.com/photo-1594913785162-e67866e4a282?auto=format&fit=crop&w=600&q=80,https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=600&q=80" | split: "," %}

        {% for i in (0..3) %}
          <div class="product-card">
            <div class="product-media-container">
              <span class="product-badge-pill">Jaipur Exclusive</span>
              <button type="button" class="product-wishlist-btn" aria-label="Save">
                {% render 'icons', name: 'heart' %}
              </button>
              <a href="/collections/all" class="product-img-link">
                <img src="{{ mock_images[i] }}" alt="{{ mock_titles[i] }}" class="product-main-image" loading="lazy" width="600" height="800">
              </a>
              <div class="product-quick-actions">
                <button type="button" class="quick-add-btn" data-cart-trigger>
                  {% render 'icons', name: 'cart' %}
                  <span>Add to Bag</span>
                </button>
              </div>
            </div>
            <div class="product-info-box">
              <span class="product-artisan-tag">Rooted in Jaipur</span>
              <h3 class="product-title"><a href="/collections/all">{{ mock_titles[i] }}</a></h3>
              <div class="product-price-row">
                <span class="price-current">{{ mock_prices[i] }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
