{% comment %}
  VastrVeda Master Product Detail Section (PDP)
{% endcomment %}

<section class="main-product-section" style="padding: 60px 0 90px;">
  <div class="vv-container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: start;">
      
      <!-- Left: Product Media Gallery -->
      <div class="product-gallery-sticky" style="position: sticky; top: 110px;">
        <div style="border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--vv-border-subtle); background: var(--vv-cream-surface); aspect-ratio: 3/4; margin-bottom: 16px;">
          {% if product.featured_image %}
            <img 
              id="MainProductImage"
              src="{{ product.featured_image | image_url: width: 900 }}" 
              alt="{{ product.title | escape }}"
              style="width: 100%; height: 100%; object-fit: cover;"
              width="900"
              height="1200"
            >
          {% else %}
            <img 
              id="MainProductImage"
              src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=900&q=80" 
              alt="{{ product.title | default: 'Royal Wedding Outfit' }}"
              style="width: 100%; height: 100%; object-fit: cover;"
              width="900"
              height="1200"
            >
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div style="display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px;">
            {% for image in product.images %}
              <button 
                type="button" 
                onclick="document.getElementById('MainProductImage').src='{{ image | image_url: width: 900 }}'"
                style="width: 80px; height: 100px; border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--vv-border-subtle); flex-shrink: 0;"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="Thumbnail" style="width: 100%; height: 100%; object-fit: cover;">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Right: Product Information & Purchase Actions -->
      <div class="product-details-content">
        <span class="royal-subheading" style="text-align: left; margin-bottom: 4px;">Jaipur Heritage Couture</span>
        <h1 style="font-family: var(--font-royal); font-size: 2.2rem; color: var(--vv-maroon-deep); margin-bottom: 12px; line-height: 1.25;">
          {{ product.title | default: 'Imperial Velvet Zardozi Wedding Lehenga' }}
        </h1>

        <!-- Price -->
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 20px;">
          <span style="font-family: var(--font-royal); font-size: 1.7rem; font-weight: 700; color: var(--vv-maroon-primary);">
            {{ product.price | money | default: '₹38,999' }}
          </span>
          {% if product.compare_at_price > product.price %}
            <span style="font-size: 1.1rem; color: var(--vv-text-muted); text-decoration: line-through;">
              {{ product.compare_at_price | money }}
            </span>
          {% endif %}
          <span style="background: rgba(212, 175, 55, 0.2); color: var(--vv-maroon-deep); font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: var(--radius-sm);">
            Complimentary Royal Delivery
          </span>
        </div>

        <p style="font-size: 0.88rem; color: var(--vv-text-muted); margin-bottom: 24px;">
          Inclusive of all taxes. Handcrafted to order in our Jaipur atelier with authentic metallic zari and certified pure silks.
        </p>

        <!-- Product Form -->
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Size Options -->
          <div style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
              <label style="font-family: var(--font-royal); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: var(--vv-maroon-deep);">
                Select Size:
              </label>
              <a href="#size-guide" style="font-size: 0.8rem; color: var(--vv-gold-primary); text-decoration: underline;">Size & Custom Fit Guide</a>
            </div>

            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              {% assign sizes = "XS,S,M,L,XL,XXL,Custom Bridal Sizing" | split: "," %}
              {% for s in sizes %}
                <label style="cursor: pointer;">
                  <input type="radio" name="size_option" value="{{ s }}" style="display: none;" {% if forloop.index == 2 %}checked{% endif %}>
                  <span class="size-pill" style="display: inline-block; padding: 10px 18px; border: 1px solid var(--vv-border-subtle); border-radius: var(--radius-sm); font-size: 0.85rem; font-family: var(--font-royal); font-weight: 600; transition: all 0.2s;">
                    {{ s }}
                  </span>
                </label>
              {% endfor %}
            </div>
          </div>

          <!-- Quantity & Add to Cart -->
          <div style="display: flex; gap: 16px; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; border: 1px solid var(--vv-border-subtle); border-radius: var(--radius-sm); background: #FFF;">
              <button type="button" onclick="const q=document.getElementById('ProdQty'); if(q.value>1)q.value--;" style="padding: 12px 16px; font-weight: 700;">-</button>
              <input type="number" id="ProdQty" name="quantity" value="1" min="1" style="width: 40px; text-align: center; border: none; font-weight: 600; outline: none;">
              <button type="button" onclick="const q=document.getElementById('ProdQty'); q.value++;" style="padding: 12px 16px; font-weight: 700;">+</button>
            </div>

            <button type="submit" class="btn-royal-gold" style="flex: 1; border: none;">
              {% render 'icons', name: 'cart' %}
              <span>Add to Royal Bag</span>
            </button>
          </div>

        {% endform %}

        <!-- Product Highlights Accordion -->
        <div style="border-top: 1px solid var(--vv-border-subtle); padding-top: 20px; display: flex; flex-direction: column; gap: 16px;">
          <details style="cursor: pointer; padding-bottom: 12px; border-bottom: 1px solid var(--vv-border-card);" open>
            <summary style="font-family: var(--font-royal); font-weight: 600; color: var(--vv-maroon-deep); display: flex; justify-content: space-between;">
              Artisanal Karigari & Heritage
              <span>+</span>
            </summary>
            <p style="font-size: 0.88rem; color: var(--vv-text-muted); margin-top: 10px; line-height: 1.7;">
              Hand-embroidered by master craftsmen in Jaipur using antique Zardozi, resham threads, and pure metallic Gota Patti work on regal base fabric.
            </p>
          </details>

          <details style="cursor: pointer; padding-bottom: 12px; border-bottom: 1px solid var(--vv-border-card);">
            <summary style="font-family: var(--font-royal); font-weight: 600; color: var(--vv-maroon-deep); display: flex; justify-content: space-between;">
              Complimentary Shipping & Delivery
              <span>+</span>
            </summary>
            <p style="font-size: 0.88rem; color: var(--vv-text-muted); margin-top: 10px; line-height: 1.7;">
              Free insured express delivery across India within 4–7 business days. Bespoke bridal orders tailored in 12–15 business days.
            </p>
          </details>

          <details style="cursor: pointer; padding-bottom: 12px; border-bottom: 1px solid var(--vv-border-card);">
            <summary style="font-family: var(--font-royal); font-weight: 600; color: var(--vv-maroon-deep); display: flex; justify-content: space-between;">
              Royal Garment Care
              <span>+</span>
            </summary>
            <p style="font-size: 0.88rem; color: var(--vv-text-muted); margin-top: 10px; line-height: 1.7;">
              Strictly dry clean only. Store in provided muslin bag away from direct sunlight to preserve delicate zari and embroidery brilliance.
            </p>
          </details>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
