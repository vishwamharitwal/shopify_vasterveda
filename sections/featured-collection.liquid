{% comment %}
  VastrVeda Featured Collection Section
{% endcomment %}

<section class="products-section">
  <div class="vv-container">
    <div class="royal-heading-wrapper">
      <span class="royal-subheading">{{ section.settings.subheading | default: 'The Festive & Wedding Edit' }}</span>
      <h2 class="royal-title">{{ section.settings.title | default: 'Trending Masterpieces' }}</h2>
      <div class="royal-divider">
        <span class="royal-divider-line"></span>
        <span class="royal-divider-icon">{% render 'icons', name: 'lotus' %}</span>
        <span class="royal-divider-line"></span>
      </div>
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    <div class="product-grid">
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'card-product', product: product %}
        {% endfor %}
      {% else %}
        <!-- Rich Fallback Mock Products for Instant Preview -->
        {% assign mock_titles = "Maroon Velvet Zardozi Bridal Lehenga,Royal Jaipuri Silk Anarkali Set,Crimson Handcrafted Gota Patti Kurti Set,Imperial Peacock Blue Wedding Lehenga" | split: "," %}
        {% assign mock_prices = "₹38,999,₹8,499,₹5,999,₹44,500" | split: "," %}
        {% assign mock_compares = "₹48,999,₹11,999,₹7,999,₹55,000" | split: "," %}
        {% assign mock_images = "https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=600&q=80,https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=600&q=80,https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=600&q=80,https://images.unsplash.com/photo-1594913785162-e67866e4a282?auto=format&fit=crop&w=600&q=80" | split: "," %}

        {% for i in (0..3) %}
          <div class="product-card">
            <div class="product-media-container">
              <span class="product-badge-pill">Wedding Special</span>
              <button type="button" class="product-wishlist-btn" aria-label="Save to Wishlist">
                {% render 'icons', name: 'heart' %}
              </button>
              <a href="/collections/all" class="product-img-link">
                <img 
                  src="{{ mock_images[i] }}" 
                  alt="{{ mock_titles[i] }}" 
                  class="product-main-image"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              </a>
              <div class="product-quick-actions">
                <button type="button" class="quick-add-btn" data-cart-trigger>
                  {% render 'icons', name: 'cart' %}
                  <span>Add to Bag</span>
                </button>
              </div>
            </div>
            <div class="product-info-box">
              <span class="product-artisan-tag">Rooted in Jaipur</span>
              <h3 class="product-title">
                <a href="/collections/all">{{ mock_titles[i] }}</a>
              </h3>
              <div class="product-price-row">
                <span class="price-current">{{ mock_prices[i] }}</span>
                <span class="price-compare">{{ mock_compares[i] }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div style="text-align: center; margin-top: 50px;">
      <a href="{{ collection.url | default: '/collections/all' }}" class="btn-royal-gold">
        <span>View Full Royal Collection</span>
        {% render 'icons', name: 'chevron-right' %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The Festive & Wedding Edit"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Masterpieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "label": "Products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
