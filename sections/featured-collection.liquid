{% comment %}
  VastrVeda Editorial Featured Collection Section
{% endcomment %}

<section class="products-section">
  <div class="vv-container">
    <div class="editorial-header">
      <span class="editorial-tag">{{ section.settings.subheading | default: 'ATELIER SELECTIONS' }}</span>
      <h2 class="editorial-title">{{ section.settings.title | default: 'Trending <em>Masterpieces</em>' }}</h2>
      <div class="editorial-divider"></div>
    </div>

    {%- assign selected_col = collections[section.settings.collection] -%}
    {%- if selected_col == blank or selected_col.products.size == 0 -%}
      {%- assign selected_col = collections['all'] -%}
    {%- endif -%}

    <div class="product-grid">
      {% if selected_col != blank and selected_col.products.size > 0 %}
        {% for product in selected_col.products limit: section.settings.products_to_show %}
          {% render 'card-product', product: product %}
        {% endfor %}
      {% elsif collections.all.products.size > 0 %}
        {% for product in collections.all.products limit: section.settings.products_to_show %}
          {% render 'card-product', product: product %}
        {% endfor %}
      {% else %}
        <!-- Editorial Mock Items -->
        {% assign mock_titles = "Maroon Velvet Zardozi Bridal Lehenga,Royal Jaipuri Silk Anarkali Set,Crimson Handcrafted Gota Patti Kurti Set,Imperial Peacock Blue Wedding Lehenga" | split: "," %}
        {% assign mock_prices = "₹38,999,₹8,499,₹5,999,₹44,500" | split: "," %}
        {% assign mock_images = "https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=700&q=85,https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?auto=format&fit=crop&w=700&q=85,https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?auto=format&fit=crop&w=700&q=85,https://images.unsplash.com/photo-1594913785162-e67866e4a282?auto=format&fit=crop&w=700&q=85" | split: "," %}

        {% for i in (0..3) %}
          <div class="product-card">
            <div class="product-media-container">
              <span class="product-badge-pill">COUTURE</span>
              <button type="button" class="product-wishlist-btn" aria-label="Save">
                {% render 'icons', name: 'heart' %}
              </button>
              <a href="/collections/all">
                <img src="{{ mock_images[i] }}" alt="{{ mock_titles[i] }}" class="product-main-image" loading="lazy" width="700" height="950">
              </a>
              <div class="product-quick-actions">
                <button type="button" class="quick-add-btn" data-cart-trigger>
                  <span>Quick Add to Bag</span>
                </button>
              </div>
            </div>
            <div class="product-info-box">
              <span class="product-artisan-tag">JAIPUR ATELIER</span>
              <h3 class="product-title">
                <a href="/collections/all">{{ mock_titles[i] }}</a>
              </h3>
              <div class="product-price-row">
                <span class="price-current">{{ mock_prices[i] }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div style="text-align: center; margin-top: 60px;">
      <a href="{{ selected_col.url | default: '/collections/all' }}" class="btn-editorial-primary">
        <span>View Full Collection</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "ATELIER SELECTIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Masterpieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "label": "Products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
