{% comment %}
  VastrVeda Haute Couture Editorial Hero (Taste + Impeccable Standard)
{% endcomment %}

<section class="hero-editorial-section">
  <!-- Background Image / Silk Visual -->
  {% if section.settings.hero_image != blank %}
    <img 
      src="{{ section.settings.hero_image | image_url: width: 1920 }}" 
      alt="{{ section.settings.heading | escape }}" 
      class="hero-editorial-bg"
      width="1920"
      height="1080"
    >
  {% else %}
    <img 
      src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=1920&q=85" 
      alt="VastrVeda Royal Bridal Couture" 
      class="hero-editorial-bg"
      width="1920"
      height="1080"
    >
  {% endif %}

  <div class="hero-editorial-overlay"></div>

  <div class="vv-container">
    <div class="hero-editorial-content">
      <span class="editorial-tag">
        {{ section.settings.badge_text | default: 'ATELIER JAIPUR • HAUTE COUTURE 2026' }}
      </span>

      <h1 class="hero-editorial-title">
        {{ section.settings.heading | default: 'Timeless Grace, <em>Imperial Weaves</em>' }}
      </h1>

      <p class="hero-editorial-desc">
        {{ section.settings.subheading | default: 'Ancestral Jaipuri craftsmanship sculpted into bespoke bridal lehengas, festive ensembles, and pure silk kurti sets.' }}
      </p>

      <div class="hero-editorial-ctas">
        <a href="{{ section.settings.primary_btn_link | default: '/collections/wedding-wear' }}" class="btn-couture-gold">
          <span>{{ section.settings.primary_btn_text | default: 'Explore Wedding Couture' }}</span>
          <span class="btn-icon-bubble">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </a>

        <a href="{{ section.settings.secondary_btn_link | default: '/collections/kurti-sets' }}" class="btn-couture-outline">
          <span>{{ section.settings.secondary_btn_text | default: 'Kurti Sets & Festive' }}</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Editorial Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge",
      "default": "ATELIER JAIPUR • HAUTE COUTURE 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Title",
      "default": "Timeless Grace, Imperial Weaves"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Text",
      "default": "Ancestral Jaipuri craftsmanship sculpted into bespoke bridal lehengas, festive ensembles, and pure silk kurti sets."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "Explore Wedding Couture"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "Kurti Sets & Festive"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Editorial Banner"
    }
  ]
}
{% endschema %}
