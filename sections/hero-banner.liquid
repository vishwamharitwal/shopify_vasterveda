{% comment %}
  VastrVeda Royal Hero Banner Section
  GSAP Animated Arch Hero
{% endcomment %}

<section class="hero-royal-section">
  <div class="hero-pattern-overlay"></div>
  <div class="vv-container">
    <div class="hero-grid">
      <!-- Left Content -->
      <div class="hero-content">
        <div class="hero-badge">
          {% render 'icons', name: 'lotus' %}
          <span>{{ section.settings.badge_text | default: 'Rooted in Indian Heritage • Jaipur' }}</span>
        </div>

        <h1 class="hero-title">
          {{ section.settings.heading | default: 'Timeless Grace, Imperial Couture' }}
        </h1>

        <p class="hero-description">
          {{ section.settings.subheading | default: 'Handcrafted bridal lehengas, festive ensembles, and royal kurti sets sculpted with ancestral Rajasthani artistry.' }}
        </p>

        <div class="hero-cta-group">
          <a href="{{ section.settings.primary_btn_link | default: '/collections/wedding-wear' }}" class="btn-royal-gold">
            <span>{{ section.settings.primary_btn_text | default: 'Explore Wedding Couture' }}</span>
            {% render 'icons', name: 'chevron-right' %}
          </a>

          <a href="{{ section.settings.secondary_btn_link | default: '/collections/kurti-sets' }}" class="btn-royal-outline">
            <span>{{ section.settings.secondary_btn_text | default: 'Kurti Sets & Sets' }}</span>
          </a>
        </div>
      </div>

      <!-- Right Arch Visual Frame -->
      <div class="hero-media-wrapper">
        <div class="hero-arch-frame">
          {% if section.settings.hero_image != blank %}
            <img 
              src="{{ section.settings.hero_image | image_url: width: 800 }}" 
              alt="{{ section.settings.heading | escape }}" 
              class="hero-image"
              width="800"
              height="1100"
            >
          {% else %}
            <!-- High quality luxury placeholder representation -->
            <img 
              src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=900&q=80" 
              alt="Royal Indian Bridal Lehenga VastrVeda" 
              class="hero-image"
              width="800"
              height="1100"
            >
          {% endif %}
        </div>

        <div class="hero-floating-card">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="color: var(--vv-gold-primary);">
              {% render 'icons', name: 'award' %}
            </div>
            <div>
              <span class="floating-city">Jaipur | Rajasthan</span>
              <p class="floating-text">100% Pure Zari & Silk</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Royal Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Label",
      "default": "Rooted in Indian Heritage • Jaipur"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Hero Title",
      "default": "Timeless Grace, Imperial Couture"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Description",
      "default": "Handcrafted bridal lehengas, festive ensembles, and royal kurti sets sculpted with ancestral Rajasthani artistry."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Model Image"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "Explore Wedding Couture"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "Kurti Sets & Festive"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Royal Banner"
    }
  ]
}
{% endschema %}
